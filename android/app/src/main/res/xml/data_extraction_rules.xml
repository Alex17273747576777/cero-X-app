<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- No incluir credenciales ni datos sensibles en backup en la nube -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="ceroX_config" />
        <exclude domain="database" path="crash_reports" />
        <exclude domain="file" path="credentials" />
        <exclude domain="file" path="api_keys" />
        <exclude domain="file" path="tokens" />
        <!-- Incluir biblioteca de usuario y configuración de temas -->
        <include domain="sharedpref" path="." />
        <include domain="database" path="library_db" />
        <include domain="database" path="app_database" />
    </cloud-backup>
    <device-transfer>
        <!-- Todo excepto datos sensibles para transferencia entre dispositivos -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="credentials" />
    </device-transfer>
</data-extraction-rules>