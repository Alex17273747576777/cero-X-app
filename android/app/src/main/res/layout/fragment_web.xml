<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/web_motor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Brave Search" />

        <Button
            android:id="@+id/web_fmhya"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FMHY" />
    </LinearLayout>

    <EditText
        android:id="@+id/web_searx_base"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/web_searx_hint"
        android:importantForAutofill="no"
        android:inputType="textUri" />

    <EditText
        android:id="@+id/web_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/web_url_hint"
        android:importantForAutofill="no"
        android:inputType="textUri" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/web_ir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/web_ir" />

        <Button
            android:id="@+id/web_atras"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/web_atras" />

        <Button
            android:id="@+id/web_recargar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/web_recargar" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/web_bloqueo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/web_bloqueo" />

    <CheckBox
        android:id="@+id/web_anti_muro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/web_anti_muro" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/web_cookies"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/web_cookies_terceros" />

        <Button
            android:id="@+id/web_limpiar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/web_limpiar" />
    </LinearLayout>

    <TextView
        android:id="@+id/web_estado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/web_reglas" />

    <WebView
        android:id="@+id/web_vista"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
