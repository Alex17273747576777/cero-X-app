<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Buscar biblioteca Kisara..."
            android:inputType="text"
            android:imeOptions="actionSearch" />

        <Button
            android:id="@+id/bulk_favorite_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Favorito Masivo" />

        <Button
            android:id="@+id/merge_entries_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fusionar" />
    </LinearLayout>

    <TextView
        android:id="@+id/library_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:text="Biblioteca local"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/library_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</LinearLayout>