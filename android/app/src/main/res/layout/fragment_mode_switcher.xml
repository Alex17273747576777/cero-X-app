<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/mode_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Modos de la App"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/current_mode_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Modo actual: Panel Principal"
        android:textSize="14sp"
        android:paddingHorizontal="16dp"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/mode_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Audio • Novela/EPUB • Manga/Cómics • Video/Imagen • Personalizado"
        android:textSize="12sp"
        android:paddingHorizontal="16dp"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/modes_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</LinearLayout>