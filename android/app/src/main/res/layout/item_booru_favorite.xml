<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/booru_item_image"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:scaleType="centerCrop"
        android:contentDescription="Miniatura de la publicación" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp">

        <TextView
            android:id="@+id/booru_item_site"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/booru_item_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:ellipsize="end"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/booru_item_score"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/booru_item_favorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:text="☆"
                android:contentDescription="Cambiar favorito" />

            <Button
                android:id="@+id/booru_item_open"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ficha" />

            <Button
                android:id="@+id/booru_item_original"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Original" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
