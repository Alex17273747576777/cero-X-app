<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/theme_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Diseño de la App"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/theme_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Elige el diseño de interfaz: Kiroku, Kototoro, AniZen, namida o Personalizado"
        android:textSize="14sp"
        android:paddingHorizontal="16dp"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/themes_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Liquid Glass (desenfoque)"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Switch
                android:id="@+id/liquid_glass_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/blur_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24dp"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <androidx.slider.widget.Slider
            android:id="@+id/blur_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="64"
            android:value="24"
            android:stepSize="4" />

    </LinearLayout>

</LinearLayout>