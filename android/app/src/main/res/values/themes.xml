<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Views: DayNight real y ActionBar para que «Volver» exista de verdad. -->
    <style name="Theme.ceroX" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/ceroX_primary</item>
        <item name="colorOnPrimary">@color/ceroX_on_primary</item>
        <item name="colorPrimaryContainer">@color/ceroX_primary_container</item>
        <item name="colorSecondary">@color/ceroX_secondary</item>
        <item name="colorOnSecondary">@color/ceroX_on_primary</item>
        <item name="colorSecondaryContainer">@color/ceroX_secondary_container</item>
        <item name="colorTertiary">@color/ceroX_tertiary</item>
        <item name="colorTertiaryContainer">@color/ceroX_tertiary_container</item>
        <item name="colorSurface">@color/ceroX_surface</item>
        <item name="colorSurfaceContainer">@color/ceroX_surface_container</item>
        <item name="colorSurfaceContainerHighest">@color/ceroX_surface_variant</item>
        <item name="colorOnSurface">@color/ceroX_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/ceroX_on_surface_variant</item>
        <item name="colorError">@color/ceroX_error</item>
        <item name="colorOnError">@color/ceroX_on_primary</item>
        <item name="android:colorBackground">@color/ceroX_background</item>
        <item name="android:windowBackground">@color/ceroX_background</item>
        <item name="android:textColorPrimary">@color/ceroX_on_surface</item>
        <item name="android:textColorSecondary">@color/ceroX_on_surface_variant</item>
        <item name="android:statusBarColor">@color/ceroX_surface</item>
        <item name="android:navigationBarColor">@color/ceroX_surface</item>
        <item name="android:windowLightStatusBar">@bool/cerox_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/cerox_light_bars</item>
        <item name="android:enableOnBackInvokedCallback">true</item>
        <item name="android:dataExtractionRules">@xml/data_extraction_rules</item>
    </style>

    <!-- Compose dibuja su propia TopAppBar: nunca una segunda barra XML. -->
    <style name="Theme.ceroX.Compose" parent="Theme.ceroX">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.ceroX.Amoled" parent="Theme.ceroX">
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceContainerHighest">#111111</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowBackground">#000000</item>
    </style>

    <style name="Theme.ceroX.Lector" parent="Theme.ceroX.Amoled">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.ceroX.Light" parent="Theme.ceroX" />

    <style name="Theme.ceroX.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/cerox_splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/cerox_fondo</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/cerox_splash_icon</item>
    </style>

</resources>
