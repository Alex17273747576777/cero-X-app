<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos básicos de red y conectividad -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Permisos de almacenamiento (Android 10+ usa scoped storage) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />

    <!-- Permisos de instalación de extensiones (SanTBox) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      INSTALL_PACKAGES es un permiso de sistema: NO se concede a apps de usuario.
      Se declara porque sin él la app no puede pedirlo por la vía de Shizuku o
      root, y porque declararlo hace visible en el manifiesto que cero-X puede
      instalar paquetes si el dispositivo le da ese poder.

      Lo que NO hace: concedérselo a sí misma. En un teléfono sin root, este
      permiso no se otorga nunca y la instalación pasa por PackageInstaller con
      confirmación del usuario. PrivilegeProbe comprueba el nivel real antes de
      prometer nada.
    -->
    <uses-permission
        android:name="android.permission.INSTALL_PACKAGES"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.DELETE_PACKAGES"
        tools:ignore="ProtectedPermissions" />

    <!--
      QUERY_ALL_PACKAGES (API 30+): necesario para QUE Shizuku, el instalador del
      sistema y los gestores de paquetes sean visibles al preguntar por ellos.
      Sin esto, getPackageInfo("moe.shizuku.privileged.api") devuelve "no
      instalado" aunque esté instalado, y la app diría que no hay Shizuku
      cuando sí lo hay. Es un falso negativo, y es peor que un fallo.

      Google Play restringe este permiso. Fuera de Play (F-Droid, GitHub
      Releases, APK directa) no hay problema, y cero-X se distribuye por APK.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
      Shizuku: el permiso que el gestor comprueba antes de autorizar a cero-X.
      Va declarado y no es opcional: sin él, `requestPermission` no llega a
      ninguna parte y el estado queda en «no autorizado» para siempre.
    -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!--
      Permiso para el servicio de instalación en segundo plano. En Android 14+
      el tipo tiene que existir y ser explícito, o el servicio no arranca.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_INSTALL_PACKAGES"
        tools:targetApi="34" />

    <!-- Servicios en primer plano -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Permisos de notificaciones (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vibración y háptico -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Bluetooth (para dispositivos periféricos) -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Hardware features (opcionales, no requeridos) -->
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.opengles.es3"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!--
      Visibilidad de paquetes por nombre, que es la forma precisa de hacerlo.
      Se listan solo los que la app necesita ver; QUERY_ALL_PACKAGES queda arriba
      como red de seguridad para variantes de Shizuku que no se conocen.
    -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="moe.shizuku.manager" />
        <package android:name="rikka.shizuku" />
        <package android:name="com.mixplorer" />
        <!-- Gestores con protocolo Dhizuku (el Device Owner de AxManagerD y
             Dhizuku van por aquí). -->
        <package android:name="com.rosan.dhizuku" />
        <package android:name="com.rosan.dhizuku.permission.BIND_DHIZUKU" />
        <package android:name="eu.kanade.tachiyomi.extension" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:name=".core.CeroXApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ceroX"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:resizeableActivity="true"
        tools:targetApi="36">

        <!-- Actividad principal -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode|density"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Catálogo: buscar, elegir obra, elegir capítulo. -->
        <activity
            android:name=".ui.catalogo.CatalogoActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode|density"
            android:label="Catálogo" />

        <!-- Lector de páginas. Es la pantalla que faltaba: sin ella, la app
             sabía descargar, colorear y cachear, pero no podía abrir un
             capítulo. Se declara con parentActivityName para que el gesto de
             volver del sistema regrese al catálogo y no cierre la app. -->
        <activity
            android:name=".ui.reader.ReaderActivity"
            android:exported="false"
            android:label="Leyendo"
            android:parentActivityName=".ui.catalogo.CatalogoActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode|density"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Sincronización con AniList / MyAnimeList. El token vive cifrado con
             el Keystore, no en preferencias en claro. -->
        <activity
            android:name=".modules.houri.tracker.TrackerActivity"
            android:exported="false"
            android:label="Sincronización"
            android:windowSoftInputMode="adjustResize" />

        <!-- Idiomas: interfaz, registro (neutro o con modismos), variante regional,
             idiomas del contenido y proveedor de traducción. El español dominicano
             es obligatorio para lo que publica La Bandita, no para la app. -->
        <activity
            android:name=".ui.idiomas.IdiomasActivity"
            android:exported="false"
            android:label="@string/titulo_idiomas"
            android:parentActivityName=".ui.main.MainActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode|density"
            android:windowSoftInputMode="adjustResize" />

        <!-- Estado del sistema: privilegios, motor JS y fuentes, comprobados. -->
        <activity
            android:name=".ui.estado.EstadoSistemaActivity"
            android:exported="false"
            android:label="Estado del sistema"
            android:parentActivityName=".ui.main.MainActivity" />

        <!-- Actividad de pruebas de estrés -->
        <activity
            android:name=".ui.StressTestActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode|density"
            android:screenOrientation="unspecified" />

        <!-- Servicio de descargas en segundo plano -->
        <service
            android:name=".modules.downloads.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Shizuku: el proveedor que el gestor consulta para saber que cero-X
             está autorizada. Sin esta línea, requestPermission no llega nunca y
             el permiso queda en «no autorizado» para siempre. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Proveedor de archivos para actualizaciones y compartir -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Receptor de cambios de conectividad -->
        <receiver
            android:name=".core.ConnectivityReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>